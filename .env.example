NEXT_PUBLIC_SITE_URL=https://greenarccommune.com
SITE_INDEXABLE=false

# Production on Vercel: connect Turso Cloud to this project (server-only secrets).
# TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
# TURSO_AUTH_TOKEN=your-database-token

# Optional local SQLite file overrides (defaults to data/enquiries.sqlite)
# ENQUIRIES_DB_PATH=/absolute/persistent/path/enquiries.sqlite
# NEXT_PUBLIC_YOUTUBE_URL=

# Private first-admin setup (use a new secret in Vercel Production settings)
# ADMIN_SETUP_KEY=generate-a-long-random-secret
# ADMIN_DB_PATH=/absolute/persistent/path/admin.sqlite
