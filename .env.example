NEXT_PUBLIC_SITE_URL=https://www.greenarccommune.com
# Optional override; the owner-supplied property is the default.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-HNQPN4JFE7
# Optional HTML verification tokens (not account passwords); DNS verification works without these.
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
# Vercel Production is indexable by default; Preview/Development always remain noindex.
# Remove an old SITE_INDEXABLE=false from Production or set it to true, then redeploy.
# Outside Vercel, opt in explicitly for the live deployment only:
# SITE_INDEXABLE=true

# Production on Vercel: connect Turso Cloud to this project (server-only secrets).
# TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
# TURSO_AUTH_TOKEN=your-database-token

# Optional local SQLite file overrides (defaults to data/enquiries.sqlite)
# ENQUIRIES_DB_PATH=/absolute/persistent/path/enquiries.sqlite
# NEXT_PUBLIC_YOUTUBE_URL=

# Private first-admin setup (use a new secret in Vercel Production settings)
# ADMIN_SETUP_KEY=generate-a-long-random-secret
# ADMIN_DB_PATH=/absolute/persistent/path/admin.sqlite





SITE_INDEXABLE=true
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-HNQPN4JFE7
